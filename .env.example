# ---------------- TWILIO CREDENTIALS ----------------
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp Sender (Twilio Sandbox default: whatsapp:+14155238886)
FROM_WHATSAPP=whatsapp:+14155238886

# Recipient WhatsApp Number (e.g., whatsapp:+919876543210)
TO_WHATSAPP=whatsapp:+91XXXXXXXXXX

# ---------------- DETECTION & SOURCE SETTINGS ----------------
# SOURCE options:
# - '0' for default webcam
# - 'screen' for desktop screen capture
# - 'ele.mp4' or path to video file
# - 'rtsp://username:password@ip:port/h264' for network camera
SOURCE=ele.mp4

# YOLO model (yolov8n.pt = fast/lightweight, yolov8s.pt = balanced, yolov8m.pt = accurate)
MODEL_NAME=yolov8s.pt

# Elephant detection confidence threshold (0.0 to 1.0)
CONFIDENCE=0.45

# Seconds to wait between WhatsApp alerts to prevent spam
ALERT_COOLDOWN=60

# Run without displaying window (recommended for servers/Docker)
HEADLESS=false
